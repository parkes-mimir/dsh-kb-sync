{
  "name": "dsh-kb-sync",
  "version": "0.4.1",
  "description": "Cross-device knowledge base sync for dsh-mnemon memory spaces: per-space local/cloud, event-driven push, hook-driven notify (config-only, no custom panel)",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "hub/",
    "examples/",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mnemon",
    "memory",
    "sync",
    "knowledge-base"
  ],
  "license": "MIT",
  "author": "parkes-mimir",
  "repository": {
    "type": "git",
    "url": "https://github.com/parkes-mimir/dsh-kb-sync.git"
  },
  "homepage": "https://github.com/parkes-mimir/dsh-kb-sync",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": true
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/parkes-mimir/dsh-kb-sync/issues"
  },
  "scripts": {
    "pack": "npm pack --dry-run"
  }
}
